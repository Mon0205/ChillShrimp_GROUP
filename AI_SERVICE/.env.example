# Copy to .env for local development and replace with your Cloudinary credentials.
# Do not commit the real .env file.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_INSPECTION_FOLDER=chillshrimp/ai-inspections/originals
# Stored by the backend with every inspection. Change it whenever models/best.pt changes.
MODEL_VERSION=v8_yolo26s_seed0
# Confidence threshold when the caller sends none (the backend does not). 0.25 counts more, 0.35 counts less.
DETECTION_CONF=0.35
