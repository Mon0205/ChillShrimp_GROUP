            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0" value="Bảng và quan hệ chính"/>
                <mxCell id="title" parent="1" style="text;html=0;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontFamily=Arial;fontColor=#0f172a;" value="DATABASE-V4 — Sơ đồ cơ sở dữ liệu (27 bảng, theo docs/ERD.md)" vertex="1">
                    <mxGeometry height="36" width="1400" x="40" y="20" as="geometry"/>
                </mxCell>
                <mxCell id="note" parent="1" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontFamily=Arial;fontColor=#475569;" value="Bố cục theo nhóm nghiệp vụ (khung nét đứt). [PK] vàng · [FK] xanh · [UK] xám · {a|b|c} = tập giá trị. Chân chim = 0..N; vạch đôi = bắt buộc 1; vòng tròn = 0..1. Đường đậm = quan hệ chính. Hai layer tắt sẵn (mở bằng Ctrl+Shift+L): &quot;FK → users&quot; (quan hệ người thực hiện/ghi nhận/tạo/duyệt) và &quot;FK → farms (phạm vi trại)&quot;. Cột FK tương ứng vẫn hiện trong từng bảng." vertex="1">
                    <mxGeometry height="56" width="1500" x="40" y="60" as="geometry"/>
                </mxCell>
