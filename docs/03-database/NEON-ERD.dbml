  performed_at timestamptz(6) [not null]
  notes text [null]
  created_at timestamptz(6) [not null, default: `now()`]
  indexes {
    (tank_id, performed_at)
    (performed_by, performed_at)
  }
}

Table public.water_parameter_logs {
  id uuid [not null, pk, note: 'UUID generated by Prisma; SQL migrations may use gen_random_uuid()']
  tank_id uuid [not null]
  recorded_by text [not null]
  temperature numeric(12,3) [null]
