  nitrate numeric(12,3) [null]
  alkalinity numeric(12,3) [null]
  h2s numeric(12,3) [null]
  turbidity numeric(12,3) [null]
  water_level_m numeric(12,3) [null]
  measurement_method varchar(20) [not null, default: 'manual']
  measurement_device varchar(100) [null]
  recorded_at timestamptz(6) [not null]
  notes text [null]
  created_at timestamptz(6) [not null, default: `now()`]
  indexes {
    (tank_id, recorded_at)
    (recorded_by, recorded_at)
  }
}

Table public.environment_thresholds {
  id uuid [not null, pk, note: 'UUID generated by Prisma; SQL migrations may use gen_random_uuid()']
  farm_id uuid [not null]
