// PostgreSQL / Neon: application schema from BE/prisma/schema.prisma.
// CHECK constraints, partial indexes and triggers: see NEON-ERD.md and repository migrations.
// Neon Auth internal schema is managed externally and is not defined here.
Project ChillShrimp {
  database_type: 'PostgreSQL'
}

Enum FarmRole {
  owner
  area_manager
  technician
  warehouse_staff
}

Enum InvitationStatus {
  pending
  accepted
  cancelled
}

Enum MembershipStatus {
  active
  suspended
}

Table public.users {
  id text [not null, pk]
  email text [not null, unique]
  username text [null, unique]
  displayName text [null]
  phone text [null]
  created_at timestamptz(6) [not null, default: `now()`]
  updated_at timestamptz(6) [not null]
}

Table public.access_sessions {
  id uuid [not null, pk, note: 'UUID generated by Prisma; SQL migrations may use gen_random_uuid()']
  user_id text [not null]
  token_hash text [not null, unique]
  last_activity timestamptz(6) [not null, default: `now()`]
  expires_at timestamptz(6) [not null]
  created_at timestamptz(6) [not null, default: `now()`]
  indexes {
    (user_id)
    (expires_at)
  }
}

Table public.farms {
  id uuid [not null, pk, note: 'UUID generated by Prisma; SQL migrations may use gen_random_uuid()']
  code text [not null, unique]
  name text [not null]
  address text [null]
  status varchar(20) [not null, default: 'active']
  created_by text [not null]
  archived_by text [null]
  archived_at timestamptz(6) [null]
  created_at timestamptz(6) [not null, default: `now()`]
  updated_at timestamptz(6) [not null]
  indexes {
    (status)
  }
}

Table public.areas {
  id uuid [not null, pk, note: 'UUID generated by Prisma; SQL migrations may use gen_random_uuid()']
  farm_id uuid [not null]
  code text [not null]
  name text [not null]
  status varchar(20) [not null, default: 'active']
  created_at timestamptz(6) [not null, default: `now()`]
  updated_at timestamptz(6) [not null]
  indexes {
    (farm_id, code) [unique]
    (farm_id, status)
  }
}

Table public.ponds_tanks {
  id uuid [not null, pk, note: 'UUID generated by Prisma; SQL migrations may use gen_random_uuid()']
  farm_id uuid [not null]
  area_id uuid [null]
  code varchar(50) [not null]
  name varchar(100) [not null]
  tank_type varchar(30) [not null, default: 'nursery_tank']
  volume_m3 numeric(12,3) [not null]
  status varchar(20) [not null, default: 'empty']
  description text [null]
  deleted_by text [null]
  deleted_at timestamptz(6) [null]
  created_at timestamptz(6) [not null, default: `now()`]
  updated_at timestamptz(6) [not null]
  indexes {
    (farm_id, code) [unique]
    (farm_id, area_id)
    (farm_id, status)
    (farm_id, deleted_at)
  }
}

Table public.feeding_logs {
  id uuid [not null, pk, note: 'UUID generated by Prisma; SQL migrations may use gen_random_uuid()']
  tank_id uuid [not null]
  performed_by text [not null]
  supply_id uuid [null]
  feed_name varchar(150) [not null]
  amount numeric(12,3) [not null]
  unit varchar(20) [not null]
  biomass_snapshot_kg numeric(12,3) [null]
  feeding_rate_percent numeric(7,3) [null]
  recommended_amount numeric(12,3) [null]
  feed_check_status varchar(20) [null]
  feeding_time timestamptz(6) [not null]
  notes text [null]
  created_at timestamptz(6) [not null, default: `now()`]
  indexes {
    (tank_id, feeding_time)
    (performed_by, feeding_time)
    (supply_id)
  }
}

Table public.water_change_logs {
  id uuid [not null, pk, note: 'UUID generated by Prisma; SQL migrations may use gen_random_uuid()']
  tank_id uuid [not null]
