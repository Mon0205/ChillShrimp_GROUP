                <mxCell id="title" value="DATABASE-V4 — Sơ đồ cơ sở dữ liệu (27 bảng, theo docs/ERD.md)" style="text;html=0;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontFamily=Arial;fontColor=#0f172a;" parent="1" vertex="1">
