# Neon Dashboard > Connection Details. Giữ sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
JWT_SECRET="replace-with-a-long-random-secret"
PORT=8000
FRONTEND_URL=http://localhost:5173

# SMTP production để gửi email lời mời. Nếu bỏ trống, URL mời chỉ được in ở terminal.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ChillShrimp <no-reply@example.com>"

# Chỉ dùng một lần để tạo tài khoản quản trị đầu tiên.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
