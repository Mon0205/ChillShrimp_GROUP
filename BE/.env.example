# Neon Dashboard > Connection Details. Giữ sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
PORT=8000
FRONTEND_URL=http://localhost:5173

# Neon Console > Auth > Configuration > Auth URL.
# Cookie secret do backend tự tạo, tối thiểu 32 ký tự; không đưa vào frontend.
NEON_AUTH_URL="https://your-project.neonauth.region.aws.neon.tech/neondb/auth"
NEON_AUTH_COOKIE_SECRET="replace-with-a-random-32-byte-base64-secret"

# Copy 5 dòng này vào BE/.env và thay your-... bằng thông tin Gmail của bạn.
# App Password: Google Account > Security > 2-Step Verification > App passwords.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-google-app-password
SMTP_FROM="ChillShrimp <your-email@gmail.com>"


# Chỉ dùng một lần để tạo tài khoản quản trị đầu tiên.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
