generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FarmRole {
  owner
  farm_manager
  area_manager
  technician
  warehouse_staff
}

enum InvitationStatus {
  pending
  accepted
  cancelled
}

model User {
  supplyRequestsProcessed InventorySupplyRequest[] @relation("SupplyRequestProcessor")
  id                  String           @id
  email               String           @unique
  username            String?          @unique
  displayName         String?
  phone               String?
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  farmsCreated        Farm[]           @relation("FarmCreator")
  pondsTanksDeleted   PondTank[]       @relation("PondTankDeleter")
  pondsTanksResponsible PondTank[]     @relation("PondTankResponsible")
  feedingLogs         FeedingLog[]
  waterChangeLogs     WaterChangeLog[]
  waterParameterLogs  WaterParameterLog[]
  treatmentLogs       TreatmentLog[]
  inventoryTransactions InventoryTransaction[]
  inventorySupplyRequests InventorySupplyRequest[] @relation("SupplyRequestRequester")
  environmentThresholdsCreated  EnvironmentThreshold[] @relation("EnvironmentThresholdCreator")
  environmentThresholdsApproved EnvironmentThreshold[] @relation("EnvironmentThresholdApprover")
  aiInspectionsCreated AiInspection[] @relation("AiInspectionCreator")
  memberships         FarmMember[]
  invitationsSent     FarmInvitation[] @relation("InvitationSender")
  invitationsReceived FarmInvitation[] @relation("InvitationRecipient")

  @@map("users")
}

model Farm {
  id            String           @id @default(uuid()) @db.Uuid
  code          String           @unique
  name          String
  address       String?
  status        String           @default("active") @db.VarChar(20)
  createdBy     String           @map("created_by")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  creator       User             @relation("FarmCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  members       FarmMember[]
  invitations   FarmInvitation[]
  areas         Area[]
  pondsTanks    PondTank[]
  seedSuppliers SeedSupplier[]
  inventorySupplies InventorySupply[]
  inventorySupplyRequests InventorySupplyRequest[]
  environmentThresholds EnvironmentThreshold[]
  alertsNotifications AlertNotification[]

  @@index([status])
  @@map("farms")
}

enum MembershipStatus {
  active
  suspended
}

model Area {
  id          String           @id @default(uuid()) @db.Uuid
  farmId      String           @map("farm_id") @db.Uuid
  code        String
  name        String
  status      String           @default("active") @db.VarChar(20)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  farm        Farm             @relation(fields: [farmId], references: [id], onDelete: Cascade)
  members     FarmMember[]
  invitations FarmInvitation[]
  pondsTanks  PondTank[]
  inventorySupplyRequests InventorySupplyRequest[]

  @@unique([farmId, code])
  @@index([farmId, status])
  @@map("areas")
}

model PondTank {
  supplyRequests InventorySupplyRequest[]
  id          String    @id @default(uuid()) @db.Uuid
  farmId      String    @map("farm_id") @db.Uuid
  areaId      String?   @map("area_id") @db.Uuid
  responsibleUserId String? @map("responsible_user_id")
  code        String    @db.VarChar(50)
  name        String    @db.VarChar(100)
  tankType    String    @default("nursery_tank") @map("tank_type") @db.VarChar(30)
  volumeM3    Decimal   @map("volume_m3") @db.Decimal(12, 3)
  status      String    @default("empty") @db.VarChar(20)
  description String?
  deletedBy   String?   @map("deleted_by")
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  farm        Farm        @relation(fields: [farmId], references: [id], onDelete: Cascade)
  area        Area?       @relation(fields: [areaId], references: [id], onDelete: Restrict)
  deleter     User?       @relation("PondTankDeleter", fields: [deletedBy], references: [id], onDelete: SetNull)
  responsibleUser User?   @relation("PondTankResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  seedBatches SeedBatch[]
  feedingLogs FeedingLog[]
  waterChangeLogs WaterChangeLog[]
  waterParameterLogs WaterParameterLog[]
  environmentalAlerts AlertNotification[]
  treatmentLogs TreatmentLog[]

  @@unique([farmId, code])
  @@index([farmId, areaId])
  @@index([farmId, status])
  @@index([farmId, deletedAt])
  @@index([responsibleUserId, deletedAt])
  @@map("ponds_tanks")
}

model FeedingLog {
  id                 String   @id @default(uuid()) @db.Uuid
  tankId             String   @map("tank_id") @db.Uuid
  performedBy        String   @map("performed_by")
  supplyId           String?  @map("supply_id") @db.Uuid
  feedName           String   @map("feed_name") @db.VarChar(150)
  amount             Decimal  @db.Decimal(12, 3)
  unit               String   @db.VarChar(20)
  feedCheckStatus    String?  @map("feed_check_status") @db.VarChar(20)
  feedingTime        DateTime @map("feeding_time") @db.Timestamptz(6)
  notes              String?
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tank      PondTank @relation(fields: [tankId], references: [id], onDelete: Restrict)
  performer User     @relation(fields: [performedBy], references: [id], onDelete: Restrict)
  supply    InventorySupply? @relation(fields: [supplyId], references: [id], onDelete: SetNull)

  @@index([tankId, feedingTime])
  @@index([performedBy, feedingTime])
  @@index([supplyId])
  @@map("feeding_logs")
}

model WaterChangeLog {
  id                    String   @id @default(uuid()) @db.Uuid
  tankId                String   @map("tank_id") @db.Uuid
  performedBy           String   @map("performed_by")
  waterChangePercentage Decimal  @map("water_change_percentage") @db.Decimal(5, 2)
  performedAt           DateTime @map("performed_at") @db.Timestamptz(6)
  notes                 String?
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tank      PondTank @relation(fields: [tankId], references: [id], onDelete: Restrict)
  performer User     @relation(fields: [performedBy], references: [id], onDelete: Restrict)

  @@index([tankId, performedAt])
  @@index([performedBy, performedAt])
  @@map("water_change_logs")
}

model WaterParameterLog {
  id                String   @id @default(uuid()) @db.Uuid
  tankId            String   @map("tank_id") @db.Uuid
  recordedBy        String   @map("recorded_by")
  temperature       Decimal? @db.Decimal(12, 3)
  ph                Decimal? @db.Decimal(12, 3)
  salinity          Decimal? @db.Decimal(12, 3)
  dissolvedOxygen   Decimal? @map("dissolved_oxygen") @db.Decimal(12, 3)
  nh3               Decimal? @db.Decimal(12, 3)
  tan               Decimal? @db.Decimal(12, 3)
  no2               Decimal? @db.Decimal(12, 3)
  nitrate           Decimal? @db.Decimal(12, 3)
  alkalinity        Decimal? @db.Decimal(12, 3)
  h2s               Decimal? @db.Decimal(12, 3)
  turbidity         Decimal? @db.Decimal(12, 3)
  waterLevelM       Decimal? @map("water_level_m") @db.Decimal(12, 3)
  measurementMethod String   @default("manual") @map("measurement_method") @db.VarChar(20)
  measurementDevice String?  @map("measurement_device") @db.VarChar(100)
  recordedAt        DateTime @map("recorded_at") @db.Timestamptz(6)
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tank     PondTank @relation(fields: [tankId], references: [id], onDelete: Restrict)
  recorder User     @relation(fields: [recordedBy], references: [id], onDelete: Restrict)
  alerts   AlertNotification[]

  @@index([tankId, recordedAt])
  @@index([recordedBy, recordedAt])
  @@map("water_parameter_logs")
}

model EnvironmentThreshold {
  id               String   @id @default(uuid()) @db.Uuid
  farmId           String   @map("farm_id") @db.Uuid
  species          String   @db.VarChar(50)
  developmentStage String   @map("development_stage") @db.VarChar(50)
  tankType         String   @map("tank_type") @db.VarChar(30)
  parameterCode    String   @map("parameter_code") @db.VarChar(30)
  unit             String   @db.VarChar(20)
  optimalMin       Decimal? @map("optimal_min") @db.Decimal(12, 3)
  optimalMax       Decimal? @map("optimal_max") @db.Decimal(12, 3)
  warningMin       Decimal? @map("warning_min") @db.Decimal(12, 3)
  warningMax       Decimal? @map("warning_max") @db.Decimal(12, 3)
  dangerMin        Decimal? @map("danger_min") @db.Decimal(12, 3)
  dangerMax        Decimal? @map("danger_max") @db.Decimal(12, 3)
  effectiveFrom    DateTime @map("effective_from") @db.Date
  effectiveTo      DateTime? @map("effective_to") @db.Date
  isActive         Boolean  @default(true) @map("is_active")
  createdBy        String   @map("created_by")
  approvedBy       String?  @map("approved_by")
  approvedAt       DateTime? @map("approved_at") @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  farm     Farm  @relation(fields: [farmId], references: [id], onDelete: Cascade)
  creator  User  @relation("EnvironmentThresholdCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  approver User? @relation("EnvironmentThresholdApprover", fields: [approvedBy], references: [id], onDelete: Restrict)
  alerts   AlertNotification[]

  @@index([farmId, isActive, effectiveFrom, effectiveTo])
  @@index([farmId, species, developmentStage, tankType, parameterCode])
  @@map("environment_thresholds")
}

model AlertNotification {
  id            String   @id @default(uuid()) @db.Uuid
  farmId        String   @map("farm_id") @db.Uuid
  batchId       String?  @map("batch_id") @db.Uuid
  tankId        String?  @map("tank_id") @db.Uuid
  thresholdId   String?  @map("threshold_id") @db.Uuid
  sourceLogId   String?  @map("source_log_id") @db.Uuid
  parameterCode String?  @map("parameter_code") @db.VarChar(30)
  observedValue Decimal? @map("observed_value") @db.Decimal(12, 3)
  alertType     String   @map("alert_type") @db.VarChar(30)
  severity      String   @db.VarChar(20)
  title         String   @db.VarChar(150)
  message       String
  isRead        Boolean  @default(false) @map("is_read")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  farm      Farm                  @relation(fields: [farmId], references: [id], onDelete: Cascade)
  batch     SeedBatch?            @relation(fields: [batchId], references: [id], onDelete: SetNull)
  tank      PondTank?             @relation(fields: [tankId], references: [id], onDelete: SetNull)
  threshold EnvironmentThreshold? @relation(fields: [thresholdId], references: [id], onDelete: SetNull)
  sourceLog WaterParameterLog?    @relation(fields: [sourceLogId], references: [id], onDelete: SetNull)

  @@unique([sourceLogId, parameterCode])
  @@index([farmId, alertType, createdAt])
  @@index([tankId, createdAt])
  @@map("alerts_notifications")
}

model TreatmentLog {
  id          String   @id @default(uuid()) @db.Uuid
  tankId      String   @map("tank_id") @db.Uuid
  performedBy String   @map("performed_by")
  supplyId    String?  @map("supply_id") @db.Uuid
  productName String   @map("product_name") @db.VarChar(150)
  amount      Decimal  @db.Decimal(12, 3)
  unit        String   @db.VarChar(20)
  purpose     String
  performedAt DateTime @map("performed_at") @db.Timestamptz(6)
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tank      PondTank        @relation(fields: [tankId], references: [id], onDelete: Restrict)
  performer User            @relation(fields: [performedBy], references: [id], onDelete: Restrict)
  supply    InventorySupply? @relation(fields: [supplyId], references: [id], onDelete: SetNull)

  @@index([tankId, performedAt])
  @@index([performedBy, performedAt])
  @@index([supplyId])
  @@map("treatment_logs")
}

model InventorySupply {
  id           String   @id @default(uuid()) @db.Uuid
  farmId       String   @map("farm_id") @db.Uuid
  name         String   @db.VarChar(150)
  category     String   @db.VarChar(30)
  unit         String   @db.VarChar(20)
  quantity     Decimal  @default(0) @db.Decimal(12, 3)
  unitPrice    Decimal  @default(0) @map("unit_price") @db.Decimal(12, 2)
  minThreshold Decimal  @default(0) @map("min_threshold") @db.Decimal(12, 3)
  description  String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)
  feedingLogs FeedingLog[]
  treatmentLogs TreatmentLog[]
  transactions InventoryTransaction[]
  requests InventorySupplyRequest[]

  @@index([farmId, category, name])
  @@map("inventory_supplies")
}

model InventoryTransaction {
  supplyRequestId String? @unique @map("supply_request_id") @db.Uuid
  supplyRequest InventorySupplyRequest? @relation(fields: [supplyRequestId], references: [id], onDelete: Restrict)
  id              String   @id @default(uuid()) @db.Uuid
  supplyId        String   @map("supply_id") @db.Uuid
  batchId         String?  @map("batch_id") @db.Uuid
  createdBy       String   @map("created_by")
  transactionType String   @map("transaction_type") @db.VarChar(20)
  quantity        Decimal  @db.Decimal(12, 3)
  unitPrice       Decimal  @default(0) @map("unit_price") @db.Decimal(12, 2)
  transactionDate DateTime @map("transaction_date") @db.Timestamptz(6)
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  supply  InventorySupply @relation(fields: [supplyId], references: [id], onDelete: Restrict)
  batch   SeedBatch?      @relation(fields: [batchId], references: [id], onDelete: SetNull)
  creator User            @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([supplyId, transactionDate])
  @@index([batchId, transactionDate])
  @@map("inventory_transactions")
}

model InventorySupplyRequest {
  processedBy String? @map("processed_by")
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  rejectionReason String? @map("rejection_reason")
  processor User? @relation("SupplyRequestProcessor", fields: [processedBy], references: [id], onDelete: SetNull)
  tankId String? @map("tank_id") @db.Uuid
  tank PondTank? @relation(fields: [tankId], references: [id], onDelete: Restrict)
  transaction InventoryTransaction?
  id          String   @id @default(uuid()) @db.Uuid
  farmId      String   @map("farm_id") @db.Uuid
  supplyId    String   @map("supply_id") @db.Uuid
  areaId      String?  @map("area_id") @db.Uuid
  requestedBy String   @map("requested_by")
  quantity    Decimal  @db.Decimal(12, 3)
  status      String   @default("pending") @db.VarChar(20)
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  farm      Farm            @relation(fields: [farmId], references: [id], onDelete: Cascade)
  supply    InventorySupply @relation(fields: [supplyId], references: [id], onDelete: Restrict)
  area      Area?           @relation(fields: [areaId], references: [id], onDelete: SetNull)
  requester User            @relation("SupplyRequestRequester", fields: [requestedBy], references: [id], onDelete: Restrict)

  @@index([farmId, status, createdAt])
  @@index([areaId, status, createdAt])
  @@index([tankId, createdAt])
  @@index([supplyId, createdAt])
  @@map("supply_requests")
}


model SeedSupplier {
  id                    String   @id @default(uuid()) @db.Uuid
  farmId                String   @map("farm_id") @db.Uuid
  name                  String   @db.VarChar(150)
  phone                 String?  @db.VarChar(20)
  address               String?

  farm        Farm        @relation(fields: [farmId], references: [id], onDelete: Cascade)
  seedBatches SeedBatch[]

  @@index([farmId, name])
  @@map("seed_suppliers")
}

model SeedBatch {
  id                       String    @id @default(uuid()) @db.Uuid
  tankId                   String    @map("tank_id") @db.Uuid
  supplierId               String?   @map("supplier_id") @db.Uuid
  batchCode                String    @unique @map("batch_code") @db.VarChar(50)
  species                  String    @db.VarChar(50)
  developmentStage         String    @map("development_stage") @db.VarChar(50)
  initialQuantity          Int       @map("initial_quantity")
  currentEstimatedQuantity Int       @map("current_estimated_quantity")
  stockedDate              DateTime  @map("stocked_date") @db.Date
  expectedSaleDate         DateTime  @map("expected_sale_date") @db.Date
  status                   String    @default("active") @db.VarChar(30)
  notes                    String?
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tank     PondTank      @relation(fields: [tankId], references: [id], onDelete: Restrict)
  supplier SeedSupplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  aiInspections AiInspection[]
  inventoryTransactions InventoryTransaction[]
  alerts AlertNotification[]

  @@index([tankId, status])
  @@index([supplierId])
  @@index([status])
  @@map("seed_batches")
}

model AiInspection {
  id                   String    @id @default(uuid()) @db.Uuid
  batchId              String    @map("batch_id") @db.Uuid
  createdBy            String    @map("created_by")
  mediaUrl             String    @map("media_url")
  mediaPublicId        String    @unique(map: "ai_inspections_media_public_id_key") @map("media_public_id") @db.VarChar(255)
  annotatedImageUrl    String?   @map("annotated_image_url")
  samplingMethod       String    @map("sampling_method") @db.VarChar(20)
  sampleVolumeMl       Decimal?  @map("sample_volume_ml") @db.Decimal(12, 3)
  manualCount          Int?      @map("manual_count")
  detectedCount        Int?      @map("detected_count")
  densityPerMl         Decimal?  @map("density_per_ml") @db.Decimal(14, 4)
  correctionFactor     Decimal?  @map("correction_factor") @db.Decimal(8, 4)
  averageConfidence    Decimal?  @map("average_confidence") @db.Decimal(6, 5)
  averageSizeMm        Decimal?  @map("average_size_mm") @db.Decimal(8, 3)
  uniformityScore      Decimal?  @map("uniformity_score") @db.Decimal(6, 3)
  detections           Json?     @db.JsonB
  modelVersion         String?   @map("model_version") @db.VarChar(100)
  status               String    @default("pending") @db.VarChar(20)
  inspectedAt          DateTime? @map("inspected_at") @db.Timestamptz(6)
  notes                String?
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  batch   SeedBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  creator User      @relation("AiInspectionCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([batchId, inspectedAt(sort: Desc)])
  @@index([createdBy])
  @@index([status, createdAt])
  @@map("ai_inspections")
}




model FarmMember {
  farmId    String           @map("farm_id") @db.Uuid
  userId    String           @map("user_id")
  role      FarmRole         @default(technician)
  status    MembershipStatus @default(active)
  areaId    String?          @map("area_id") @db.Uuid
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  farm      Farm             @relation(fields: [farmId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  area      Area?            @relation(fields: [areaId], references: [id], onDelete: Restrict)

  @@id([farmId, userId])
  @@map("farm_members")
}

model FarmInvitation {
  id            String           @id @default(uuid()) @db.Uuid
  farmId        String           @map("farm_id") @db.Uuid
  invitedUserId String?          @map("invited_user_id")
  email         String
  role          FarmRole
  areaId        String?          @map("area_id") @db.Uuid
  invitedBy     String           @map("invited_by")
  tokenHash     String           @unique @map("token_hash")
  expiresAt     DateTime         @map("expires_at") @db.Timestamptz(6)
  status        InvitationStatus @default(pending)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  acceptedAt    DateTime?        @map("accepted_at") @db.Timestamptz(6)
  farm          Farm             @relation(fields: [farmId], references: [id], onDelete: Cascade)
  invitedUser   User?            @relation("InvitationRecipient", fields: [invitedUserId], references: [id], onDelete: SetNull)
  sender        User             @relation("InvitationSender", fields: [invitedBy], references: [id])
  area          Area?            @relation(fields: [areaId], references: [id], onDelete: Restrict)

  @@index([farmId, email, status])
  @@map("farm_invitations")
}

model PasswordResetOtpWindow {
  email     String   @id
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("password_reset_otp_windows")
}
